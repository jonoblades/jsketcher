{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "numeric": ["./web/lib/numeric-1.2.6.js"],
      "*": [
        "./modules/*",
        "./web/app/*"
      ]
    }
  },
  "include": [
    "modules/**/*",
    "web/app/**/*",
    "externals.d.ts"
  ]
}
